# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# Create the roles and database first: scripts/db/setup-roles.sql
# Why there are two datasources: docs/persistence.md

SPRING_PROFILES_ACTIVE='dev'


# Flyway, at startup. Owns the schema, holds DDL rights.
FLYWAY_URL='jdbc:postgresql://localhost:5432/poi'
FLYWAY_USERNAME='poi_migrator'
FLYWAY_PASSWORD='changeme_migrator'


# The running app. DML only.
# Behind PgBouncer, use its port and add prepareThreshold=0 - docs/scaling.md
DB_URL='jdbc:postgresql://localhost:5432/poi'
DB_USERNAME='poi_app'
DB_PASSWORD='changeme_app'
