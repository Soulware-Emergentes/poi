# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# Create the roles and database first: scripts/db/setup-roles.sql
# Why there are two datasources: docs/persistence.md

SPRING_PROFILES_ACTIVE='dev'


# Flyway, at startup. Owns the schema, holds DDL rights.
FLYWAY_URL='jdbc:postgresql://localhost:5432/poi'
FLYWAY_USERNAME='poi_migrator'
FLYWAY_PASSWORD='changeme_migrator'


# The running app. DML only.
# Behind PgBouncer, use its port and add prepareThreshold=0 - docs/scaling.md
DB_URL='jdbc:postgresql://localhost:5432/poi'
DB_USERNAME='poi_app'
DB_PASSWORD='changeme_app'


# staff, the identity provider. Only tokens it issued to a person or a service
# for POI_TOKEN_AUDIENCE are accepted: STAFF_ISSUER must match staff's own, and
# the audience is the identifier this deployment of poi is registered under there.
STAFF_ISSUER='http://localhost:8082'
POI_TOKEN_AUDIENCE='poi-api-dev'

# The origin the frontend's browser calls come from.
POI_WEB_ORIGIN='http://localhost:5174'


# Whether the OpenAPI document and the Swagger UI are served.
API_DOCS_ENABLED='true'
